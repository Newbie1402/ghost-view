# live uses actual public providers; mock is explicit development/test fixture mode.
PROVIDER_MODE=live
ADDR=:8080
WEB_DIR=web
PROVIDER_TIMEOUT=8s
DOWNLOAD_TIMEOUT=15s
DOWNLOAD_MAX_BYTES=26214400
RATE_LIMIT_PER_MINUTE=120
CACHE_MAX_ENTRIES=1000
SHUTDOWN_TIMEOUT=10s
# Comma-separated exact origins. Empty permits same-origin requests only.
CORS_ALLOWED_ORIGINS=
